# =============================================================================
# Growvanta CRM — Apache / LiteSpeed configuration
#
# Drop this at the document root (public_html on cPanel) alongside index.html.
# Everything here works on stock shared hosting: no VirtualHost access needed.
# =============================================================================

Options -Indexes
# The marketing site is the front door; the application lives at
# /index.html and the SPA fallback below still routes its deep links.
DirectoryIndex home.html

# -----------------------------------------------------------------------------
# Never serve application internals, whatever the request path looks like.
# -----------------------------------------------------------------------------
<FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.md|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# Block direct browsing of the server-side directories. api/ and webhooks/ are
# the only PHP entry points; lib/, services/, database/, cron/ and scripts/
# are includes and build tooling, never served.
RewriteRule ^(lib|services|database|cron|scripts)/ - [F,L]

# bootstrap.php and config.php are includes, never endpoints.
RewriteRule ^(bootstrap|config)\.php$ - [F,L]

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Everything under /api/ goes through the single front controller, which needs
# the Authorization header forwarded (some CGI/FastCGI setups strip it).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# -----------------------------------------------------------------------------
# Public capture short URLs
#   /f/KEY        → hosted form page
#   /embed/KEY.js → embeddable form script
# -----------------------------------------------------------------------------
# GV_EMBEDDABLE marks the hosted page so the blanket X-Frame-Options below is
# skipped for it — it is meant to be iframed on customer sites, and its own
# Content-Security-Policy (frame-ancestors *) is what governs that.
RewriteRule ^f/([A-Za-z0-9_.-]+)/?$ api/index.php?_path=/public/hosted/$1 [QSA,L,E=GV_EMBEDDABLE:1]
RewriteRule ^embed/([A-Za-z0-9_.-]+)\.js$ api/index.php?_path=/public/embed/$1 [QSA,L,E=GV_EMBEDDABLE:1]

# -----------------------------------------------------------------------------
# Webhook receivers are real files; let them through untouched.
# -----------------------------------------------------------------------------
RewriteRule ^webhooks/ - [L]

# -----------------------------------------------------------------------------
# SPA fallback: the app owns client-side routing, so any path that is not an
# existing file and has no file extension serves the shell.
# -----------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^ index.html [L]

# -----------------------------------------------------------------------------
# Caching: hashed-free asset files change on deploy, so keep HTML uncached and
# let static assets sit in the browser for an hour.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|woff2?|png|jpg|jpeg|gif|webp)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Baseline hardening for every response, except the hosted form page which
  # must stay embeddable (see GV_EMBEDDABLE above).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN" env=!GV_EMBEDDABLE
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
