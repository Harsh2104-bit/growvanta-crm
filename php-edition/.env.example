# =============================================================================
# Growvanta CRM — environment configuration
#
# Copy this file to `.env` in the same directory and fill it in. `.env` is
# blocked from HTTP access by .htaccess, but keep it out of version control too.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# `production` turns off debug output and REFUSES TO BOOT without a real APP_KEY.
APP_ENV=production
APP_DEBUG=0

# No trailing slash. Used to build form embed snippets, invite links and the
# Meta webhook URL, so it must match the address users actually visit.
APP_URL=https://crm.yourdomain.com

# 32+ random characters. Derives session tokens and encrypts stored integration
# secrets (Meta page access tokens), so CHANGING IT INVALIDATES BOTH.
# Generate one:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# -----------------------------------------------------------------------------
# Database — from cPanel > MySQL Databases
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_growvanta
DB_USER=cpaneluser_crm
DB_PASS=

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Absolute path preferred. Must be writable by PHP (0755 is usually enough on
# cPanel, where PHP runs as your own user).
UPLOAD_DIR=
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Rate limiting (counted in the rate_limit_hits table)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
PUBLIC_CAPTURE_RATE_LIMIT_MAX=60

# -----------------------------------------------------------------------------
# The platform mailbox
#
# One mailbox sends for the whole system: invites, password resets, and every
# staff alert - new lead, follow-up due, morning summary - for every company on
# this install. Customers configure nothing for those to work.
#
# This is NOT the address buyers hear from. That one is set per company inside
# the CRM under WhatsApp & Email, and is a separate mailbox.
#
# Leave SMTP_HOST empty and the CRM still runs: alerts stay in the in-app
# notification centre and the delivery log records "the platform mailer is not
# configured", while invite and reset links go to the PHP error log.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_ENCRYPTION=TLS
SMTP_USER=alert@yourdomain.com
SMTP_PASS=
SMTP_FROM="Growvanta CRM <alert@yourdomain.com>"

# -----------------------------------------------------------------------------
# Meta (Facebook & Instagram) Lead Ads
# From developers.facebook.com > your app > Settings > Basic.
# META_VERIFY_TOKEN is any string you choose; paste the same value into
# Meta's Webhooks > Page > leadgen subscription form.
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v19.0

# -----------------------------------------------------------------------------
# Cron
# Only needed if your host's cron can fetch a URL but not run a PHP binary.
# Generate one:  php -r "echo bin2hex(random_bytes(16));"
# -----------------------------------------------------------------------------
CRON_TOKEN=

# -----------------------------------------------------------------------------
# Seed data
# The password every demo account gets when you run database/seed.php.
# -----------------------------------------------------------------------------
SEED_PASSWORD=Growvanta@123
